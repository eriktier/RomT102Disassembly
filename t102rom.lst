----                             19130  	
7315    CD 7E 6D                 19131  L7315H:	CALL  L6D7EH    ; Get a character from RS232 receive queue
7318    D8                       19132  	RC              ; Point to 3rd command byte
7319    FE 7F                    19133  	CPI   7FH       ; Get 3rd command byte
731B    37                       19134  	STC             
731C    3F                       19135  	CMC             ; Get MSB of RX data count
731D    C0                       19136  	RNZ             ; OR in LSB of RX data count
731E    47                       19137  	MOV   B,A       ; Jump to pop all regs & EI if count=0
731F    3A 5B F6                 19138  	LDA   VISTAT    ; RS232 parameter setting table
7322    FE 3A                    19139  	CPI   3AH       
7324    78                       19140  	MOV   A,B       ; Increment buffer pointer
7325    3F                       19141  	CMC             ; Decrement RX count
7326    C9                       19142  	RET             ; Jump to receive all data from external device
----                             19143  	
7327    3C                       19144  	INR   A         
7328    C9                       19145  	RET             
