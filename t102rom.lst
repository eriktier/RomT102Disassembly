----                             19947  ; Boot routine
----                             19948  ; ======================================================
7D33    31 C0 FC                 19949  BOOT	lxi   SP,VAALCD  ; Different from M100: Start of Alt LCD character buffer
7D36    3D                       19950  	dcr   A         ; Different from M100
7D37    C2 A8 1B                 19951  	jnz   L1BA8H    ; Different from M100
7D3A    DB D8                    19952  L7D3AH	in    0D8H       ; Different from M100
7D3C    A7                       19953  	ana   A         ; Different from M100
7D3D    F2 3A 7D                 19954  	jp    L7D3AH    ; Different from M100
7D40    3E 43                    19955  	mvi   A,43H     ; Load configuration for PIO (A=OUT, B=OUT, C=IN, Stop Timer counter)
7D42    D3 B8                    19956  	out   0B8H       ; Set PIO chip configuration
7D44    3E EC                    19957  	mvi   A,0ECH     ; PIO B configuration (RTS low, DTR low, SPKR=1, Serial=Modem, Keyscan col 9 enable)
7D46    D3 BA                    19958  	out   0BAH       ; Set PIO chip port B configuration
7D48    3E FF                    19959  	mvi   A,0FFH     ; PIO A configuration (Used for Key scan, LCD data, etc.)
7D4A    D3 B9                    19960  	out   0B9H       ; Initialize PIO chip port A
7D4C    DB E8                    19961  	in    0E8H       ; Scan Keyboard to test for CTRL-BREAK (cold boot indicator)
7D4E    E6 82                    19962  	ANI   82H       ; Mask all but CTRL-BREAK keys
7D50    3E ED                    19963  	mvi   A,0EDH     ; Load code to disable key-scan col 9 (for CTRL-BREAK)
7D52    D3 BA                    19964  	out   0BAH       ; Disable key-scan col 9
7D54    CA E7 7D                 19965  	jz    CBOOT     ; Cold boot routine
7D57    2A F0 F5                 19966  	lhld  VSSYS     ; Active system signature -- Warm vs Cold boot
7D5A    11 4D 8A                 19967  	lxi   D,8A4DH   ; Compare value to test if cold boot needed
7D5D    DF                       19968  	rst   3         ; Compare DE and HL
7D5E    C2 E7 7D                 19969  	jnz   CBOOT     ; Cold boot routine
7D61    3A C1 FA                 19970  	lda   0FAC1H     ; Load MSB of lowest known RAM address
7D64    57                       19971  	mov   D,A       ; Save value of last physical RAM
7D65    CD E1 7E                 19972  	call  L7EE1H    ; Calculate physical RAM available
7D68    BA                       19973  	cmp   D         ; Test if more or less RAM than last boot-up
7D69    C2 E7 7D                 19974  	jnz   CBOOT     ; Cold boot routine
7D6C    CD 05 F6                 19975  	call  VOPTRD    ; Call RAM routine to Detect Option ROM (copied to RAM by cold-boot)
7D6F    3E 00                    19976  	mvi   A,00H     ; Indicate no Option ROM detected
7D71    C2 75 7D                 19977  	jnz   L7D75H    ; Jump if it's really true to skip DEC
7D74    3D                       19978  	dcr   A         ; Indicate OptROM detected
7D75    21 2A F6                 19979  L7D75H	lxi   H,VOPTRF  ; Option ROM flag
7D78    BE                       19980  	cmp   M         ; Test if option ROM added or removed
7D79    C2 E7 7D                 19981  	jnz   CBOOT     ; Cold boot routine
7D7C    2A F2 F5                 19982  	lhld  VSPOPD    ; Load signature for Auto Poweroff
7D7F    EB                       19983  	xchg            ; Put signature in DE
7D80    21 00 00                 19984  	lxi   H,0000H   ; Prepare to clear signature for Auto Poweroff
7D83    22 F2 F5                 19985  	shld  VSPOPD    ; Clear signature for Auto Poweroff
7D86    21 0B 9C                 19986  	lxi   H,9C0BH   ; Load comparison signature saved by Auto Poweroff
7D89    DF                       19987  	rst   3         ; Compare DE and HL
7D8A    C2 A8 7D                 19988  	jnz   L7DA8H    ; Jump if last power-off wasn't an auto power-off
7D8D    2A BE FA                 19989  	lhld  0FABEH     ; SP save area for power up/down
7D90    F9                       19990  	sphl            ; Restore the stack pointer from auto-power off location
7D91    CD F6 F5                 19991  	call  VPWONH    ; Call Boot-up Hook
7D94    CD D0 7D                 19992  	call  L7DD0H    ; Call to a "hidden" XRA in the boot routine
7D97    2A F8 FF                 19993  	lhld  0FFF8H     
7D9A    E5                       19994  	push  H         
7D9B    CD 01 46                 19995  	call  L4601H    
7D9E    E1                       19996  	pop   H         
7D9F    7C                       19997  	mov   A,H       
7DA0    A7                       19998  	ana   A         
7DA1    CA ED 14                 19999  	jz    L14EDH    ; Pop AF), BC), DE), HL from stack
7DA4    F9                       20000  	sphl            
7DA5    C3 35 74                 20001  	jmp   L7435H    
----                             20002  	
7DA8    3A 51 F6                 20003  L7DA8H	lda   0F651H     ; In TEXT because of BASIC EDIT flag
7DAB    A7                       20004  	ana   A         ; Test if power off during a BASIC edit session
7DAC    CA BB 7D                 20005  	jz    L7.dbBH    ; Jump if we weren't in a BASIC edit session at power off
7DAF    CD D0 7D                 20006  	call  L7DD0H    ; Call Boot-up s.equence below, skipping IPL, BASIC NEW, etc.
7DB2    CD 53 5D                 20007  	call  L5D53H    ; Stop BASIC execution, Restore BASIC SP & clear SHIFT-PRINT Key
7DB5    CD 01 46                 20008  	call  L4601H    
7DB8    C3 DD 5F                 20009  	jmp   L5FDDH    ; Main TEXT edit loop
----                             20010  	
7DBB    21 AF FA                 20011  L7.dbBH	lxi   H,0FAAFH   ; Start of IPL filename
7DBE    22 2C F6                 20012  	shld  0F62CH     ; Save as simulated "FKey text" to be entered
7DC1    2A 78 F6                 20013  	lhld  VTPRAM    ; BASIC string buffer pointer
7DC4    F9                       20014  	sphl            ; Restore the SP
7DC5    CD F6 F5                 20015  	call  VPWONH    ; Call Boot-up Hook
7DC8    CD 6D 3F                 20016  	call  L3F6DH    ; Initialize BASIC for new execution
7DCB    21 97 57                 20017  	lxi   H,L5797H  ; Load address of the MENU program
7DCE    E5                       20018  	push  H         ; And push it to the stack as a RET address
7DCF    F6 AF                    20019  	ORI   0AFH       ; Hidden entry .. make 0AFH below look like ORI 0AFH
7DD1    CD E0 6C                 20020  	call  L6CE0H    ; Warm start reset entry
7DD4    AF                       20021  	xra   A         
7DD5    32 56 F6                 20022  	sta   VPROFS    ; Power off exit condition switch
7DD8    3A 43 FF                 20023  	lda   0FF43H     ; RS232 initialization status
7DDB    A7                       20024  	ana   A         ; Test if RS232 was active at power-off
7DDC    C8                       20025  	rz              ; Return if RS-232 was not active
7DDD    21 5A F6                 20026  	lxi   H,0F65AH   ; RS232 auto linefeed switch
7DE0    D7                       20027  	rst   2         ; Get next non-white char from M
7DE1    D4 57 34                 20028  	cnc   L3457H    ; Increment HL and return
7DE4    C3 E6 17                 20029  	jmp   L17E6H    ; Set RS232 parameters from string at M
