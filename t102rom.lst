7D61    3A C1 FA                 19964  	LDA   0FAC1H     ; Load MSB of lowest known RAM address
7D64    57                       19965  	MOV   D,A       ; Save value of last physical RAM
7D65    CD E1 7E                 19966  	CALL  L7EE1H    ; Calculate physical RAM available
7D68    BA                       19967  	CMP   D         ; Test if more or less RAM than last boot-up
7D69    C2 E7 7D                 19968  	JNZ   CBOOT     ; Cold boot routine
7D6C    CD 05 F6                 19969  	CALL  VOPTRD    ; Call RAM routine to Detect Option ROM (copied to RAM by cold-boot)
7D6F    3E 00                    19970  	MVI   A,00H     ; Indicate no Option ROM detected
