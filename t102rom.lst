7304    CD D9 35                 19121  L7304H:	CALL  L35D9H    ; different from m100 to: 7328H
7307    E5                       19122  	PUSH  H         ; /
7308    2A 1A FC                 19123  	LHLD  VFAC1I     ; Start of FAC1 for integers
730B    11 F0 F5                 19124  	LXI   D,VSSYS   ; Active system signature -- Warm vs Cold boot
730E    DF                       19125  	RST   3         ; Compare DE and HL
730F    EB                       19126  	XCHG            
