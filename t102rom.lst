7380    C3 3C 74                 19206  	JMP   L743CH    
----                             19207  	
----                             19208  ; ======================================================
----                             19209  ; Set clock chip mode
----                             19210  ; ======================================================
7383    D3 B9                    19211  L7383H:	OUT   0B9H       ; Write mode to clock chip (lower 3 bits)
7385    3A 45 FF                 19212  	LDA   VPRTE8    ; Contents of port 0E8H
7388    F6 04                    19213  	ORI   04H       ; Set CLOCK bit
738A    D3 E8                    19214  	OUT   0E8H       ; Write CLOCK strobe high
738C    E6 FB                    19215  	ANI   0FBH       ; Clear CLOCK bit
738E    D3 E8                    19216  	OUT   0E8H       ; Write CLOCK strobe low
7390    C9                       19217  	RET             
----                             19218  	
----                             19219  ; ======================================================
----                             19220  ; Cursor BLINK - Continuation of RST 7.5 Background hook
----                             19221  ; ======================================================
7391    CD 5C 76                 19222  L7391H:	CALL  L765CH    ; Disable Background task & barcode interrupts
7394    21 55 70                 19223  	LXI   H,L7055H  ; Load address of Keyboard scanning management routine
7397    E5                       19224  	PUSH  H         ; Push return address to stack
7398    21 F3 FF                 19225  	LXI   H,VPCRBC  ; Load pointer to cursor blink count-down
739B    35                       19226  	DCR   M         ; Decrement the cursor blink count-down
739C    C0                       19227  	RNZ             ; Return (to Keyboard scanning) if not time to blink
739D    36 7D                    19228  	MVI   M,7DH     ; Re-initialize cursor blink counter
739F    2B                       19229  	DCX   H         ; Decrement to address of cursor blink on-off status
73A0    7E                       19230  	MOV   A,M       ; Get current cursor blink blink on-off status
73A1    B7                       19231  	ORA   A         ; Test if blink disabled
73A2    F2 A6 73                 19232  	JP    L73A6H    ; Jump to change blink state if not disabled
73A5    E0                       19233  	RPO             ; Return if blink on-off status Parity is odd (0x80)
73A6    EE 01                    19234  L73A6H:	XRI   01H       ; Toggle the cursor blink on-of state
73A8    77                       19235  	MOV   M,A       ; Update the new cursor blink state
----                             19236  	
----                             19237  ; ======================================================
----                             19238  ; Blink the cursor
----                             19239  ; ======================================================
73A9    E5                       19240  L73A9H:	PUSH  H         ; Save HL on stack
73AA    21 EC FF                 19241  	LXI   H,VACRBP  ; Cursor bit pattern storage
73AD    16 00                    19242  	MVI   D,00H     
73AF    CD A2 74                 19243  	CALL  L74A2H    ; Byte Plot - Send bit pattern to LCD for character
73B2    06 06                    19244  	MVI   B,06H     ; Prepare to compliment 6 bytes of Cursor pixels
73B4    2B                       19245  	DCX   H         ; HL now points to end of cursor bit pattern
73B5    7E                       19246  L73B5H:	MOV   A,M       ; Get next byte of cursor pattern
73B6    2F                       19247  	CMA             ; Compliment all bits in Cursor pattern
73B7    77                       19248  	MOV   M,A       ; Save it back
73B8    2B                       19249  	DCX   H         ; Decrement to next col of cursor bits
73B9    05                       19250  	DCR   B         ; Decrement loop counter
73BA    C2 B5 73                 19251  	JNZ   L73B5H    ; Jump until count = 0
73BD    23                       19252  	INX   H         ; Increment to cursor bit storage again
73BE    16 01                    19253  	MVI   D,01H     
73C0    CD A2 74                 19254  	CALL  L74A2H    ; Byte Plot - Send bit pattern to LCD for character
73C3    E1                       19255  	POP   H         ; Restore HL
73C4    C9                       19256  	RET             ; This will return to Keyscan routine for RST 7.5 hook from above
----                             19257  	
----                             19258  ; ======================================================
----                             19259  ; Turn off background task, blink & reinitialize cursor blink time
----                             19260  ; ======================================================
73C5    E5                       19261  L73C5H:	PUSH  H         ; Push registers to stack to preserve
73C6    D5                       19262  	PUSH  D         
73C7    C5                       19263  	PUSH  B         
73C8    F5                       19264  	PUSH  PSW       
73C9    CD 5C 76                 19265  	CALL  L765CH    ; Disable Background task & barcode interrupts
73CC    21 F2 FF                 19266  	LXI   H,VCBLKC  ; Load address of Cursor blink counter
73CF    7E                       19267  	MOV   A,M       ; Load Cursor blink counter
73D0    0F                       19268  	RRC             ; Test if time to blink
73D1    DC A9 73                 19269  	CC    L73A9H    ; Blink the cursor
73D4    36 80                    19270  	MVI   M,80H     ; Initialize Cursor blink counter
73D6    C3 F4 71                 19271  	JMP   L71F4H    ; Set new interrupt mask and pop all regs & RET
----                             19272  	
----                             19273  ; ======================================================
----                             19274  ; Initialize Cursor Blink to start blinking
----                             19275  ; ======================================================
73D9    F5                       19276  L73D9H:	PUSH  PSW       ; Preserve PSW on stack
73DA    E5                       19277  	PUSH  H         ; Preserve HL on stack
73DB    CD 5C 76                 19278  	CALL  L765CH    ; Disable Background task & barcode interrupts
73DE    21 F2 FF                 19279  	LXI   H,VCBLKC  ; Load address of Cursor blink counter
73E1    7E                       19280  	MOV   A,M       ; Get current Cursor blink flag
73E2    E6 7F                    19281  	ANI   7FH       ; Mask off upper bit
73E4    77                       19282  	MOV   M,A       ; Save new cursor blink flag
73E5    23                       19283  	INX   H         ; Point to LSB of cursor blink counter
73E6    36 01                    19284  	MVI   M,01H     ; Set blink count to 1 maybe
73E8    3E 09                    19285  	MVI   A,09H     ; Load new interrupt mask value
73EA    30                       19286  	SIM             ; Set new interrupt mask
73EB    E1                       19287  	POP   H         ; Restore HL
73EC    F1                       19288  	POP   PSW       ; Restore PSW
73ED    C9                       19289  	RET             
