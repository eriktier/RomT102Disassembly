----                             18934  	
----                             18935  	
----                             18936  ; ======================================================
----                             18937  ; L7242H: Scan keyboard for a key. Return with or without 
----                             18938  ;        one. (CTRL-BREAK ==> CTRL-C)
----                             18939  ; Entry conditions: none
----                             18940  ; Exit conditions:  A = Character, if any
----                             18941  ;           Z Flag -- set if no key found
----                             18942  ;                  -- reset if key found
----                             18943  ;           Carry  -- set (character in code table below)
----                             18944  ;                  -- reset (normal characther set code)
----                             18945  ; When Carry is set (1), Register A will contain one of 
----                             18946  ; the following:
----                             18947  ;           Register A  Key pressed
----                             18948  ;           ----------  -------------
----                             18949  ;             0            F1
----                             18950  ;             1            F2
----                             18951  ;             2            F3
----                             18952  ;             3            F4
----                             18953  ;             4            F5
----                             18954  ;             5            F6
----                             18955  ;             6            F7
----                             18956  ;             7            F8
----                             18957  ;             8          LABEL
----                             18958  ;             9          PRINT
----                             18959  ;            10          SHIFT-PRINT
----                             18960  ;            11          PASTE
----                             18961  ; ======================================================
7242    CD 5C 76                 18962  KYREAD:	CALL L765CH     ; Set interrupt to 1DH
7245    3A AA FF                 18963  	LDA  0FFAAH      ; Keyboard buffer count
7248    B7                       18964  	ORA  A
7249    CA 6A 72                 18965  	JZ   L726AH     ; Enable interrupts as normal
724C    21 AC FF                 18966  	LXI  H,0FFACH
724F    7E                       18967  	MOV  A,M
7250    C6 02                    18968  	ADI  02H
7252    2B                       18969  	DCX  H
7253    7E                       18970  	MOV  A,M
7254    F5                       18971  	PUSH PSW
7255    2B                       18972  	DCX  H
7256    35                       18973  	DCR  M
7257    7E                       18974  	MOV  A,M
7258    07                       18975  	RLC
7259    4F                       18976  	MOV  C,A
725A    23                       18977  	INX  H
725B    11 AD FF                 18978  	LXI  D,0FFADH
725E    0D                       18979  L725E:	DCR  C
725F    FA 69 72                 18980  	JM   L7269
7262    1A                       18981  	LDAX D
7263    77                       18982  	MOV  M,A
7264    23                       18983  	INX  H
7265    13                       18984  	INX  D
7266    C3 5E 72                 18985  	JMP  L725E
7269    F1                       18986  L7269:	POP  PSW
----                             18987  	
----                             18988  ; ======================================================
----                             18989  ; Enable interrupts as normal
----                             18990  ; ======================================================
726A    F5                       18991  L726AH:	PUSH  PSW       
726B    3E 09                    18992  	MVI   A,09H     
726D    30                       18993  	SIM             
726E    F1                       18994  	POP   PSW       
726F    C9                       18995  	RET             
----                             18996  	
----                             18997  	
----                             18998  ; ======================================================
----                             18999  ; L7270H: Check keyboard queue for characters or BREAK
----                             19000  ; Entry conditions: none
----                             19001  ; Exit conditions:  Z flag set if queue empty,
----                             19002  ;                   reset if keys pending
----                             19003  ;       Carry -- Set when BREAK entered
----                             19004  ;             -- Reset with any other key
----                             19005  ; ======================================================
7270    CD 83 72                 19006  KEYX:	CALL BRKCHK     ; Check for break or wait (CTRL-S)
7273    CA 7E 72                 19007  	JZ   L727E
7276    FE 03                    19008  	CPI  03H
7278    C2 7E 72                 19009  	JNZ  L727E
727B    B7                       19010  	ORA  A
727C    37                       19011  	STC
727D    C9                       19012  	RET
727E    3A AA FF                 19013  L727E:	LDA  0FFAAH      ; Keyboard buffer count
7281    B7                       19014  	    ORA  A
7282    C9                       19015      	RET
----                             19016  	
----                             19017  ; ======================================================
----                             19018  ; L7283H: Check for BREAK characters only (CTRL-C or -S)
----                             19019  ; Entry conditions: none
----                             19020  ; Exit conditions:  
----                             19021  ;       Carry -- Set when BREAK or PAUSE entered
----                             19022  ;             -- Reset if no BREAK characters
----                             19023  ; ======================================================
----                             19024  ; Check for break or wait (CTRL-S)
7283    E5                       19025  BRKCHK:	PUSH H
7284    21 EB FF                 19026  	LXI  H,0FFEBH    ; Holds CTRL-C or CTRL-S until it is processed
7287    7E                       19027  	MOV  A,M        ; Test for pending CTRL-C or CTRL-S
7288    36 00                    19028  	MVI  M,00H      ; Clear pending CTRL-C or CTRL-S
728A    E1                       19029  	POP  H
728B    B7                       19030  	ORA  A          ; Test if either was pending
728C    F0                       19031  	RP              ; Return if CTRL-C or CTRL-S pending
728D    E5                       19032  	PUSH H
728E    C5                       19033  	PUSH B
728F    21 CA F7                 19034  	LXI  H,0F7CAH
7292    4F                       19035  	MOV  C,A
7293    06 00                    19036  	MVI  B,00H
7295    09                       19037  	DAD  B
7296    09                       19038  	DAD  B
7297    09                       19039  	DAD  B
7298    CD D2 3F                 19040  	CALL L3FD2H     ; Trigger interrupt.  HL points to interrupt table
729B    C1                       19041  	POP  B
729C    E1                       19042  	POP  H
729D    AF                       19043  	XRA  A
729E    C9                       19044  	RET
----                             19045  	
----                             19046  ; ======================================================
----                             19047  ; L729FH: Check if SHIFT-BREAK is being pressed
----                             19048  ; ======================================================
729F    C5                       19049  CHSHBR:	PUSH B
72A0    DB B9                    19050  	IN   0B9H
72A2    4F                       19051  	MOV  C,A
72A3    CD B1 72                 19052  	CALL SCMODK     ; Scan BREAK,CAPS,NUM,CODE,GRAPH,CTRL,SHIFT & set bits in A
72A6    F5                       19053  	PUSH PSW
72A7    79                       19054  	MOV  A,C
72A8    D3 B9                    19055  	OUT  0B9H
72AA    F1                       19056  	POP  PSW
72AB    C1                       19057  	POP  B
72AC    E6 81                    19058  	ANI  81H
72AE    C0                       19059  	RNZ
72AF    37                       19060  	STC
72B0    C9                       19061  	RET
----                             19062  ; Scan BREAK,CAPS,NUM,CODE,GRAPH,CTRL,SHIFT & set bits in A
72B1    3E FF                    19063  SCMODK:	MVI  A,0FFH
72B3    D3 B9                    19064  	OUT  0B9H
72B5    DB BA                    19065  	IN   0BAH
72B7    E6 FE                    19066  	ANI  0FEH
72B9    47                       19067  	MOV  B,A
72BA    D3 BA                    19068  	OUT  0BAH
72BC    DB E8                    19069  	IN   0E8H
72BE    F5                       19070  	PUSH PSW
72BF    78                       19071  	MOV  A,B
72C0    3C                       19072  	INR  A
72C1    D3 BA                    19073  	OUT  0BAH
72C3    F1                       19074  	POP  PSW
72C4    C9                       19075  	RET
----                             19076  	
----                             19077  	
----                             19078  ; ======================================================
----                             19079  ; Produce a tone of DE freq and B duration
----                             19080  ; ======================================================
72C5    F3                       19081  L72C5H:	DI              
72C6    7B                       19082  	MOV   A,E       
72C7    D3 BC                    19083  	OUT   0BCH       
72C9    7A                       19084  	MOV   A,D       
72CA    F6 40                    19085  	ORI   40H       
72CC    D3 BD                    19086  	OUT   0BDH       
72CE    3E C3                    19087  	MVI   A,0C3H     
72D0    D3 B8                    19088  	OUT   0B8H       
72D2    DB BA                    19089  	IN    0BAH       
72D4    E6 F8                    19090  	ANI   0F8H       
72D6    F6 20                    19091  	ORI   20H       
72D8    D3 BA                    19092  	OUT   0BAH       
72DA    CD 9F 72                 19093  L72DAH:	CALL  CHSHBR    ; Check if SHIFT-BREAK is being pressed
72DD    D2 E8 72                 19094  	JNC   L72E8H    
72E0    3E 03                    19095  	MVI   A,03H     
72E2    32 EB FF                 19096  	STA   0FFEBH     ; Holds CTRL-C or CTRL-S until it is processed
72E5    C3 F9 72                 19097  	JMP   L72F9H    
----                             19098  	
72E8    0E 64                    19099  L72E8H:	MVI   C,64H     
72EA    C5                       19100  L72EAH:	PUSH  B         
72EB    0E 1E                    19101  	MVI   C,1EH     
72ED    CD 57 76                 19102  	CALL  L7657H    ; Delay routine - decrement C until zero
72F0    C1                       19103  	POP   B         
72F1    0D                       19104  	DCR   C         
72F2    C2 EA 72                 19105  	JNZ   L72EAH    
72F5    05                       19106  	DCR   B         
72F6    C2 DA 72                 19107  	JNZ   L72DAH    
72F9    DB BA                    19108  L72F9H:	IN    0BAH       
72FB    F6 04                    19109  	ORI   04H       
72FD    D3 BA                    19110  	OUT   0BAH       
72FF    CD 83 6E                 19111  	CALL  L6E83H    
7302    FB                       19112  	EI              
