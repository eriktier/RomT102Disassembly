----    EQU 0000                  243      .org 0000H
----                              244  ; ======================================================
----                              245  ; Reset Vector
----                              246  ; ======================================================
0000    C3 A7 1B                  247          jmp  L1BA7H    ; Different from M100: Jump to boot routine
----                              248  	
----    EQU 0003                  249      .org 0003H
0003    4D 45 4E 55 00            250      .db  "MENU",00H
----                              251  	
----    EQU 0008                  252      .org 0008H
----                              253  ; ======================================================
----                              254  ; Compare next byte with M
----                              255  ; ======================================================
0008    7E                        256          mov  A,M        ; Get byte from (HL)
0009    E3                        257          xthl            ; Get address of next inst. from stack
000A    BE                        258          cmp  M          ; Compare with expected code byte
000B    C2 46 04                  259          jnz  ERRSYN     ; Generate Syntax error if no match
000E    23                        260          inx  H          ; Increment past the compare byte
000F    E3                        261          xthl            ; Put new return address on stack
----                              262  	
----                              263  ; Fall through to get next BASIC instruction. The code above is
----                              264  ; used to parse the validity of BASIC statements.
----                              265  	
----    EQU 0010                  266      .org 0010H
----                              267  ; ======================================================
----                              268  ; Get next non-white char from M
----                              269  ; ======================================================
0010    C3 58 08                  270          jmp  L0858H     ; RST 10H routine with pre-increment of HL
----                              271  
----                              272  	
----                              273  ; ======================================================
----                              274  ; Load pointer to Storage of TEXT Line Starts in DE
----                              275  ; ======================================================
0013    EB                        276          xchg
0014    2A EB F6                  277          lhld VTXTLS      ; Storage of TEXT Line Starts
0017    EB                        278          xchg
----                              279  	
----                              280  	
----    EQU 0018                  281      .org 0018H
----                              282  ; ======================================================
----                              283  ; Compare DE and HL
----                              284  ; ======================================================
0018    7C                        285          mov  A,H        ; Compare MSB first to test <>
0019    92                        286          sub  D          ; Compare with D
001A    C0                        287          rnz             ; Return if not .equal
001B    7D                        288          mov  A,L        ; Prepare to test LSB
001C    93                        289          sub  E          ; Compare with E
001D    C9                        290          ret
