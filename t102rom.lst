722C    79                       18914  L722CH:	MOV   A,C       
722D    FE 1A                    18915  	CPI   1AH       
722F    D0                       18916  	RNC             
7230    1E 2C                    18917  	MVI   E,2CH     
7232    C9                       18918  	RET             
----                             18919  	
----                             18920  	
----                             18921  ; ======================================================
----                             18922  ; Handle NUM key during key decoding
