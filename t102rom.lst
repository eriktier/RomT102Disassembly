----                             18405  	
----                             18406  	
----                             18407  ; ======================================================
----                             18408  ; Write cassette header and sync byte
----                             18409  ; ======================================================
6F46    01 00 02                 18410  L6F46H:	LXI   B,L0200H  ; SYNC header is 512 bytes of 55h
6F49    3E 55                    18411  L6F49H:	MVI   A,55H     ; Load 55h byte
6F4B    C5                       18412  	PUSH  B         ; Save remaining count
6F4C    CD 5E 6F                 18413  	CALL  L6F5EH    ; Send next 55h byte to CAS
6F4F    C1                       18414  	POP   B         ; Pop count
6F50    0B                       18415  	DCX   B         ; Decrement count
6F51    78                       18416  	MOV   A,B       ; Prepare to test for zero
6F52    B1                       18417  	ORA   C         ; OR in LSB to test for zero
6F53    C2 49 6F                 18418  	JNZ   L6F49H    ; Loop until 512 bytes sent
6F56    3E 7F                    18419  	MVI   A,7FH     ; After 512 bytes of 55h, send one 7Fh byte
6F58    C3 5E 6F                 18420  	JMP   L6F5EH    ; Send final 7FH byte to CAS
----                             18421  	
----                             18422  	
----                             18423  ; ======================================================
----                             18424  ; Write char in A to cassette w/o checksum or sync bit
----                             18425  ; ======================================================
6F5B    CD 71 6F                 18426  L6F5BH:	CALL  L6F71H    ; Call routine to send a single 0 bit before the byte
6F5E    06 08                    18427  L6F5EH:	MVI   B,08H     ; Prepare to send 8 bits of data
6F60    CD 6A 6F                 18428  L6F60H:	CALL  L6F6AH    ; Write bit 0 of A to cassette
6F63    05                       18429  	DCR   B         ; Decrement bit counter
6F64    C2 60 6F                 18430  	JNZ   L6F60H    ; Loop for all 8 bits
6F67    C3 9F 72                 18431  	JMP   CHSHBR    ; Check if SHIFT-BREAK is being pressed
----                             18432  	
----                             18433  	
----                             18434  ; ======================================================
----                             18435  ; Write bit 0 of A to cassette
----                             18436  ; ======================================================
6F6A    07                       18437  L6F6AH:	RLC             ; Rotate MSB into Carry
6F6B    11 24 1F                 18438  	LXI   D,L1F24H  ; Cassette frequency cycle count
6F6E    DA 74 6F                 18439  	JC    L6F74H    ; Jump if MSB is a 1
6F71    11 49 43                 18440  L6F71H:	LXI   D,L4349H  ; Cassette frequency cycle count
6F74    15                       18441  L6F74H:	DCR   D         ; Decrement the counter
6F75    C2 74 6F                 18442  	JNZ   L6F74H    ; Loop until D is zero
6F78    57                       18443  	MOV   D,A       ; Save byte being sent in D
6F79    3E D0                    18444  	MVI   A,0D0H     ; Prepare to set Serial Output data to 1
6F7B    30                       18445  	SIM             ; Set SOD to 1
6F7C    1D                       18446  L6F7CH:	DCR   E         ; Decrement E
6F7D    C2 7C 6F                 18447  	JNZ   L6F7CH    ; Loop until E is zero
6F80    3E 50                    18448  	MVI   A,50H     ; Prepare to set Serial Output Data to 0
6F82    30                       18449  	SIM             ; Set SOD to 0
6F83    7A                       18450  	MOV   A,D       ; Restore byte being sent
6F84    C9                       18451  	RET             
----                             18452  	
----                             18453  	
----                             18454  ; ======================================================
----                             18455  ; Read cassette header and sync byte
----                             18456  ; ======================================================
6F85    06 80                    18457  L6F85H:	MVI   B,80H     ; Set sync bit counter to 128 (16 bytes)
6F87    CD DB 6F                 18458  L6F87H:	CALL  L6FDBH    ; Read Cassette port data bit
6F8A    D8                       18459  	RC              ; Return if CTRL-BREAK pressed
6F8B    79                       18460  	MOV   A,C       ; Get count of square wave period
6F8C    FE 08                    18461  	CPI   08H       ; Test if period less than 8
6F8E    DA 85 6F                 18462  	JC    L6F85H    ; Read cassette header and sync byte
6F91    FE 40                    18463  	CPI   40H       ; Test if period greater than 64
6F93    D2 85 6F                 18464  	JNC   L6F85H    ; Read cassette header and sync byte
6F96    05                       18465  	DCR   B         ; Decrement sync bit count
6F97    C2 87 6F                 18466  	JNZ   L6F87H    ; Loop for 128 bits (16 bytes)
6F9A    CD 9F 72                 18467  L6F9AH:	CALL  CHSHBR    ; Check if SHIFT-BREAK is being pressed
6F9D    D8                       18468  	RC              ; Return if SHIFT-BREAK pressed
6F9E    21 00 00                 18469  	LXI   H,0000H   ; Set count of 0->1 and 0->0 transitions to zero
6FA1    06 40                    18470  	MVI   B,40H     ; Load bit count to 64 (8 bytes)
6FA3    CD 16 70                 18471  L6FA3H:	CALL  L7016H    ; Read a bit (period in C)
6FA6    D8                       18472  	RC              ; Return if SHIFT-BREAK pressed
6FA7    51                       18473  	MOV   D,C       ; Save bit period in D
6FA8    CD 16 70                 18474  	CALL  L7016H    ; Read next bit (period in C)
6FAB    D8                       18475  	RC              ; Return if SHIFT-BREAK pressed
6FAC    7A                       18476  	MOV   A,D       ; Get period of first bit
6FAD    91                       18477  	SUB   C         ; Subtract period of 2nd bit
6FAE    D2 B3 6F                 18478  	JNC   L6FB3H    ; \
6FB1    2F                       18479  	CMA             ; > Create ABS(D-C)
6FB2    3C                       18480  	INR   A         ; /
6FB3    FE 0B                    18481  L6FB3H:	CPI   0BH       ; Test for 0->1 or 1->0 bit transition
6FB5    DA BA 6F                 18482  	JC    L6FBAH    ; Jump to increment 0->0 or 1->1 bit detection
6FB8    24                       18483  	INR   H         ; Increment 0->1 or 1->0 bit transition count
6FB9    3E 2C                    18484  	MVI   A,2CH     ; Make INR L below look like MVI A,2CH
6FBB    05                       18485  	DCR   B         ; Decrement bit counter
6FBC    C2 A3 6F                 18486  	JNZ   L6FA3H    ; Jump to test next 2 bits
6FBF    3E 40                    18487  	MVI   A,40H     ; Prepare to test for 8 bytes of all zero or all 0FFH
6FC1    BD                       18488  	CMP   L         ; Do the compare
6FC2    CA C9 6F                 18489  	JZ    L6FC9H    ; If 8 bytes of zeros found, jump to skip test for 55H
6FC5    94                       18490  	SUB   H         ; Subtract count of 0->1 or 1->0 transition (55H bytes)
6FC6    C2 9A 6F                 18491  	JNZ   L6F9AH    ; If not equal number of zeros and 55H, go read more bits
6FC9    32 8E FF                 18492  L6FC9H:	STA   0FF8EH     ; Cassette port pulse control
6FCC    16 00                    18493  	MVI   D,00H     ; Clear out the packed byte
6FCE    CD DB 6F                 18494  L6FCEH:	CALL  L6FDBH    ; Read Cassette port data bit
6FD1    D8                       18495  	RC              ; Return if SHIFT-BREAK pressed
6FD2    CD 23 70                 18496  	CALL  L7023H    ; Count and pack cassette input bits
6FD5    FE 7F                    18497  	CPI   7FH       ; Test for 7FH sync trailer byte
6FD7    C2 CE 6F                 18498  	JNZ   L6FCEH    ; Jump to read next bit until 7FH found or SHIFT-BREAK
6FDA    C9                       18499  	RET             
----                             18500  	
----                             18501  	
----                             18502  ; ======================================================
----                             18503  ; Read Cassette port data bit
