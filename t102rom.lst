EQU 0000                            237      org 0000H
----                              238  ; ======================================================
----                              239  ; Reset Vector
----                              240  ; ======================================================
0000    C3 A7 1B                  241          JMP  L1BA7H    ; Different from M100: Jump to boot routine
----                              242  	
EQU 0003                            243      org 0003H
0003    4D 45 4E 55 00            244      DB  "MENU",00H
----                              245  	
EQU 0008                            246      org 0008H
----                              247  ; ======================================================
----                              248  ; Compare next byte with M
----                              249  ; ======================================================
0008    7E                        250          MOV  A,M        ; Get byte from (HL)
0009    E3                        251          XTHL            ; Get address of next inst. from stack
000A    BE                        252          CMP  M          ; Compare with expected code byte
000B    C2 46 04                  253          JNZ  ERRSYN     ; Generate Syntax error if no match
000E    23                        254          INX  H          ; Increment past the compare byte
000F    E3                        255          XTHL            ; Put new return address on stack
----                              256  	
----                              257  ; Fall through to get next BASIC instruction. The code above is
----                              258  ; used to parse the validity of BASIC statements.
----                              259  	
EQU 0010                            260      org 0010H
----                              261  ; ======================================================
----                              262  ; Get next non-white char from M
----                              263  ; ======================================================
0010    C3 58 08                  264          JMP  L0858H     ; RST 10H routine with pre-increment of HL
----                              265  
----                              266  	
----                              267  ; ======================================================
----                              268  ; Load pointer to Storage of TEXT Line Starts in DE
----                              269  ; ======================================================
0013    EB                        270          XCHG
0014    2A EB F6                  271          LHLD VTXTLS      ; Storage of TEXT Line Starts
0017    EB                        272          XCHG
----                              273  	
----                              274  	
EQU 0018                            275      org 0018H
----                              276  ; ======================================================
----                              277  ; Compare DE and HL
----                              278  ; ======================================================
0018    7C                        279          MOV  A,H        ; Compare MSB first to test <>
0019    92                        280          SUB  D          ; Compare with D
001A    C0                        281          RNZ             ; Return if not equal
001B    7D                        282          MOV  A,L        ; Prepare to test LSB
001C    93                        283          SUB  E          ; Compare with E
001D    C9                        284          RET
----                              285  	
EQU 001E                            286      org 001EH
----                              287  ; ======================================================
----                              288  ; VRVIDFSend a space to screen/printer
----                              289  ; ======================================================
001E    3E 20                     290          MVI  A,20H      ; Load SPACE into A
----                              291  	
----                              292  	
EQU 0020                            293      org 0020H
----                              294  ; ======================================================
----                              295  ; Send character in A to screen/printer
----                              296  ; ======================================================
0020    C3 44 4B                  297          JMP  LCD         ; Send A to screen or printer
0023    00                        298          NOP
----                              299  	
----                              300  	
EQU 0024                            301      org 0024H
----                              302  ; ======================================================
