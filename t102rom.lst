732F    3E 03                    19153  	MVI   A,03H     
7331    C4 83 73                 19154  	CNZ   L7383H    ; Set clock chip mode
7334    3E 01                    19155  	MVI   A,01H     
7336    CD 83 73                 19156  	CALL  L7383H    ; Set clock chip mode
7339    0E 07                    19157  	MVI   C,07H     
733B    CD 57 76                 19158  	CALL  L7657H    ; Delay routine - decrement C until zero
733E    06 0A                    19159  	MVI   B,0AH     
7340    0E 04                    19160  L7340H:	MVI   C,04H     
7342    56                       19161  	MOV   D,M       
7343    F1                       19162  L7343H:	POP   PSW       
7344    F5                       19163  	PUSH  PSW       
7345    CA 52 73                 19164  	JZ    L7352H    ; Read next bit from Clock Chip
7348    DB BB                    19165  	IN    0BBH       
734A    1F                       19166  	RAR             
734B    7A                       19167  	MOV   A,D       
734C    1F                       19168  	RAR             
734D    57                       19169  	MOV   D,A       
734E    AF                       19170  	XRA   A         
734F    C3 5D 73                 19171  	JMP   L735DH    
----                             19172  	
----                             19173  ; ======================================================
----                             19174  ; Read next bit from Clock Chip
----                             19175  ; ======================================================
7352    7A                       19176  L7352H:	MOV   A,D       
7353    0F                       19177  	RRC             
7354    57                       19178  	MOV   D,A       
7355    3E 10                    19179  	MVI   A,10H     
7357    1F                       19180  	RAR             
7358    1F                       19181  	RAR             
7359    1F                       19182  	RAR             
735A    1F                       19183  	RAR             
735B    D3 B9                    19184  	OUT   0B9H       
735D    F6 09                    19185  L735DH:	ORI   09H       
735F    D3 B9                    19186  	OUT   0B9H       
7361    E6 F7                    19187  	ANI   0F7H       
7363    D3 B9                    19188  	OUT   0B9H       
7365    0D                       19189  	DCR   C         
7366    C2 43 73                 19190  	JNZ   L7343H    
7369    7A                       19191  	MOV   A,D       
736A    0F                       19192  	RRC             
736B    0F                       19193  	RRC             
736C    0F                       19194  	RRC             
736D    0F                       19195  	RRC             
736E    E6 0F                    19196  	ANI   0FH       
7370    77                       19197  	MOV   M,A       
7371    23                       19198  	INX   H         
7372    05                       19199  	DCR   B         
7373    C2 40 73                 19200  	JNZ   L7340H    
7376    F1                       19201  	POP   PSW       
7377    3E 02                    19202  	MVI   A,02H     
7379    CC 83 73                 19203  	CZ    L7383H    ; Set clock chip mode
737C    AF                       19204  	XRA   A         
