76D5    77                       19688  	MOV   M,A       ; Save next byte to RAM hook location
76D6    23                       19689  	INX   H         ; Increment to next RAM hook location
76D7    05                       19690  	DCR   B         ; Decrement byte counter
76D8    C2 D2 76                 19691  	JNZ   L76D2H    ; Jump to read next byte if until all bytes read
76DB    C3 00 E0                 19692  	JMP   0E000H     
