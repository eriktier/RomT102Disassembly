----    EQU 001E                  292      .org 001EH
----                              293  ; ======================================================
----                              294  ; VRVIDFSend a space to screen/printer
----                              295  ; ======================================================
001E    3E 20                     296          mvi  A,20H      ; Load SPACE into A
----                              297  	
----                              298  	
----    EQU 0020                  299      .org 0020H
----                              300  ; ======================================================
----                              301  ; Send character in A to screen/printer
