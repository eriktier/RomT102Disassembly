76DE    F5                       19694  L76DEH:	PUSH  PSW       ; Save the PSW
76DF    CD 9F 72                 19695  L76DFH:	CALL  CHSHBR    ; Check if SHIFT-BREAK is being pressed
76E2    DA F4 76                 19696  	JC    L76F4H    ; Jump to exit loop if SHIFT-BREAK pressed
76E5    DB 82                    19697  	IN    82H       ; Get DVI status byte
76E7    07                       19698  	RLC             ; Rotate DVI TX EMPTY bit (MSB) into C flag
76E8    D2 DF 76                 19699  	JNC   L76DFH    ; Jump if not ready to keep waiting
76EB    3A FA FF                 19700  	LDA   0FFFAH     ; Retrieve value to send to DVI port 81H
76EE    D3 81                    19701  	OUT   81H       ; Send value in 0FFFAH (03H) to DVI port 81H
76F0    F1                       19702  	POP   PSW       ; Pop byte to be sent to DVI from stack
76F1    D3 80                    19703  	OUT   80H       ; Send next byte to DVI
76F3    C9                       19704  	RET             
