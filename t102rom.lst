----                             15113  ; Position cursor for next directory entry
----                             15114  ; ======================================================
59C9    D5                       15115  L59C9H	push  D         ; Save regs on stack
59CA    E5                       15116  	push  H         ; ...
59CB    7D                       15117  	mov   A,L       ; Put entry count in A
59CC    1F                       15118  	rar             ; A = count / 2
59CD    1F                       15119  	rar             ; A = count / 4
59CE    E6 3F                    15120  	ANI   3FH       ; Keep only lower bits (this is the row #)
59D0    5F                       15121  	mov   E,A       ; Put row number in E
59D1    1C                       15122  	inr   E         ; Make row number 1 based
59D2    1C                       15123  	inr   E         ; Skip top row (Time, copyright, etc. goes there)
59D3    7D                       15124  	mov   A,L       ; Get count in A
59D4    E6 03                    15125  	ANI   03H       ; Determine which of the 4 columns to display in
59D6    87                       15126  	add   A         ; A = COL * 2
59D7    57                       15127  	mov   D,A       ; Save in D
59D8    87                       15128  	add   A         ; A = COL * 4
59D9    87                       15129  	add   A         ; A = COL * 8
59DA    82                       15130  	add   D         ; A = COL * 10 (10 chars per entry)
59DB    57                       15131  	mov   D,A       ; Save in D
59DC    14                       15132  	inr   D         ; Display the entry 2 COLS indented
59DD    14                       15133  	inr   D         ; ...
59DE    EB                       15134  	xchg            ; Put COL / ROW
59DF    CD 7C 42                 15135  	call  POSIT     ; Set the current cursor position (H=Row),L=Col)
59E2    E1                       15136  	pop   H         ; Restore regs
59E3    D1                       15137  	pop   D         ; ...
59E4    C9                       15138  	ret             
