----                             20155  ; ======================================================
----                             20156  ; Calculate physical RAM available
----                             20157  ; ======================================================
7EE1    21 00 C0                 20158  L7EE1H:	LXI   H,0C000H   ; Ram modules start at High memory (8K chunks)
7EE4    7E                       20159  L7EE4H:	MOV   A,M       ; Load current value at this address
7EE5    2F                       20160  	CMA             ; Compliment the value
7EE6    77                       20161  	MOV   M,A       ; And write it back (non-destructive test)
7EE7    BE                       20162  	CMP   M         ; Compare if the value "took" (i.e. there's RAM there)
7EE8    2F                       20163  	CMA             ; Compliment data back to original value
7EE9    77                       20164  	MOV   M,A       ; Save original value (in case there IS RAM there)
7EEA    7C                       20165  	MOV   A,H       ; Load MSB of current RAM bank to A
7EEB    C2 F8 7E                 20166  	JNZ   L7EF8H    ; Jump if no RAM present in this bank
7EEE    2C                       20167  	INR   L         ; Increment LSB of RAM (test 256 bytes per 8K)
7EEF    C2 E4 7E                 20168  	JNZ   L7EE4H    ; Jump to test next byte of this RAM
7EF2    D6 20                    20169  	SUI   20H       ; Decrement to next lower 8K memory range
7EF4    67                       20170  	MOV   H,A       ; Save the new MSB of this 8K range
7EF5    FA E4 7E                 20171  	JM    L7EE4H    ; Jump back to test if RAM in this memory range
7EF8    2E 00                    20172  L7EF8H:	MVI   L,00H     ; Clear LSB of lowest RAM address
7EFA    C6 20                    20173  	ADI   20H       ; Add 8K back to address (we over shot)
7EFC    67                       20174  	MOV   H,A       ; Save MSB of lowest RAM address with RAM in it
7EFD    22 C0 FA                 20175  	SHLD  0FAC0H     ; Lowest RAM address used by system
7F00    C9                       20176  	RET             
